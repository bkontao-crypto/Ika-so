# Copiez ce fichier en .env (jamais dans le dépôt, jamais dans une archive livrée) ou posez ces variables chez l'hébergeur.
# Valeurs par défaut = POSTE LOCAL. Chez l'hébergeur : NODE_ENV=production et TRUST_PROXY=1 (voir README, « Production »).
#  - development : le code SMS s'affiche à l'écran, le premier inscrit devient super administrateur, cookie utilisable en http://localhost.
#  - production  : SMS réels obligatoires, cookie « Secure » (HTTPS exigé), aucun administrateur créé sans BOOTSTRAP_ADMIN.
NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://utilisateur:MOT_DE_PASSE@localhost:5432/ika_so
# Nombre de proxys de confiance devant l'application : 1 sur Render (la limitation de débit lit alors la vraie adresse
# du visiteur ; elle n'est jamais stockée). 0 en local. Évitez « true » : un visiteur pourrait forger son adresse.
TRUST_PROXY=0

# SMS réels (sans eux, aucun numéro n'est « vérifié » et la vérification est refusée en production)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Premier administrateur : en production, désactivé par défaut. Créez le compte propriétaire dès le premier démarrage,
# puis retirez BOOTSTRAP_ADMIN. Pour créer le premier super administrateur,
# posez BOOTSTRAP_ADMIN=true ET BOOTSTRAP_ADMIN_EMAIL=votre@adresse (seule cette adresse peut le devenir).
# BOOTSTRAP_ADMIN=true
# BOOTSTRAP_ADMIN_EMAIL=

# Démonstration seulement : affiche le code SMS à l'écran, sans badge « vérifié ». Interdit en production réelle.
# ALLOW_DEMO_OTP=true

# Journaux : debug, info (défaut), warn, error
# LOG_LEVEL=info

# Suivi d'erreurs externe (facultatif, vide = journaux seuls). Reçoit chaque erreur serveur en JSON.
# ERROR_WEBHOOK_URL=

# Adresse publique du site (plan du site, liens canoniques). Exemple : https://ikaso.example
# PUBLIC_URL=

# --- Fournisseurs tiers : TOUS ÉTEINTS tant que vides. Guide : docs/fournisseurs.md ---
# SMS Infobip (alternative à Twilio) : SMS_PROVIDER=infobip
# INFOBIP_BASE_URL=xxxx.api.infobip.com   (le https:// est ajouté si absent)
# INFOBIP_API_KEY=
# INFOBIP_FROM=
# Paiement mobile money : PAYMENT_PROVIDER=cinetpay ou paydunya (PUBLIC_URL en https obligatoire)
# CINETPAY_API_KEY=
# CINETPAY_SITE_ID=
# PAYDUNYA_MASTER_KEY=
# PAYDUNYA_PRIVATE_KEY=
# PAYDUNYA_TOKEN=
# PAYDUNYA_MODE=test
# PAYMENT_CHANNELS=MOBILE_MONEY
# E-mail d'alertes (facultatif) : EMAIL_PROVIDER=brevo ou resend
# EMAIL_FROM=
# EMAIL_FROM_NAME=Ika So
# BREVO_API_KEY=
# RESEND_API_KEY=

# Collecte d'événements d'usage (statistiques du centre de contrôle) : ÉTEINTE par défaut. Ne l'activez qu'après l'avis juridique ;
# il faut ensuite aussi mettre le réglage analytics_enabled = true en base. « Ne pas suivre » est respecté.
ANALYTICS_ENABLED=false

# Sauvegardes automatiques (pg_dump) : dossier HORS public, sur un disque persistant, et nombre de fichiers gardés.
# Nécessite pg_dump et pg_restore (client PostgreSQL) sur le serveur ; l'image Docker les installe.
# Le fichier reste sur CE serveur : pour une copie chiffrée hors serveur, lancer scripts/backup.sh depuis un poste de confiance.
# BACKUP_DIR=/data/backups
# BACKUP_KEEP=14
